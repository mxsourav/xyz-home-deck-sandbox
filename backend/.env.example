# NVIDIA NIM Configuration (supports NVIDIA_API_KEY or NVIDIA_NIM_API_KEY)
NVIDIA_API_KEY=nvapi-xxxx
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Comma-separated frontend origins allowed via CORS
FRONTEND_ORIGIN=https://xyz-home-deck-sandbox.vercel.app,http://localhost:5173
